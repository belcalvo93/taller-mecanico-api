# Copiar a .env (no versionado) y completar los secretos. No poner secretos acá.

# Base de datos
POSTGRES_USER=taller
# Contraseña de la base (obligatoria, sin valor por defecto)
POSTGRES_PASSWORD=
POSTGRES_DB=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Clave de firma del JWT (obligatoria, mínimo 32 caracteres, FIJA: se genera una vez).
# Generarla con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=1800
COOKIE_SECURE=false

# bcrypt
BCRYPT_COST=12
BCRYPT_MAX_CONCURRENT=4

# Motor
DB_POOL_SIZE=5
# true en desarrollo para ver las consultas SQL en consola
SQL_ECHO=true
